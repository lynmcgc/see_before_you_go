// .env.example
# OneMap Credentials (for token minting via https://www.onemap.gov.sg/api/auth/post/getToken)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Or direct OneMap Bearer Token (if already minted)
ONEMAP_API_KEY=

# LTA DataMall Account Key (for real-time Traffic Incidents & Cameras)
LTA_DATAMALL_KEY=
