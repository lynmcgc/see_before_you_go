// .env.example
# OneMap Credentials (for token minting via https://www.onemap.gov.sg/api/auth/post/getToken)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Or direct OneMap Bearer Token (if already minted)
ONEMAP_API_KEY=

# LTA DataMall Account Key (for real-time Traffic-Imagesv2 & Traffic Incidents)
LTA_DATAMALL_ACCOUNT_KEY=
LTA_DATAMALL_KEY=

# Data.gov.sg API Key (x-api-key header for /v1/transport/traffic-images)
DATA_GOV_SG_API_KEY=
